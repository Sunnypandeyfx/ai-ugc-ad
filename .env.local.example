# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — console.anthropic.com > API Keys
ANTHROPIC_API_KEY=

# HeyGen — app.heygen.com/developers/api
HEYGEN_API_KEY=

# Dodo Payments — dashboard > Developer > API Keys
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode

# fal.ai — fal.ai/dashboard/keys (used for shot video generation)
FAL_KEY=

# Optional: your production domain, once you have one (no trailing slash).
# Without it, shot generation still works via status polling; only the
# faster webhook path is skipped.
APP_URL=
